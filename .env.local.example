# AGT - Ambiente de Homologação (HML)
# Chaves de Assinatura: Produtor + Emissor

# =====================================
# CHAVE DO PRODUTOR (Software Developer)
# =====================================
# Usada para assinar jwsSoftwareSignature
# Exemplo de chave RSA 2048 (substitua com sua chave real)
# Gerada com: openssl genrsa -out producer-key.pem 2048
AGT_PRODUCER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQE........
SUBSTITUA_COM_SUA_CHAVE_PRIVADA_PRODUTOR_AQUI
-----END PRIVATE KEY-----"

# =====================================
# CHAVE DO EMISSOR (Contribuinte/Taxpayer)
# =====================================
# Usada para assinar jwsDocumentSignature
# Exemplo de chave RSA 2048 (substitua com sua chave real)
# Gerada com: openssl genrsa -out issuer-key.pem 2048
AGT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQE........
SUBSTITUA_COM_SUA_CHAVE_PRIVADA_EMISSOR_AQUI
-----END PRIVATE KEY-----"

# =====================================
# CONFIGURAÇÃO DA AGT
# =====================================
# Base URL do serviço (HML = Homologação)
AGT_BASE_URL="https://sifphml.minfin.gov.ao/sigt/fe/v1"

# Credenciais de autenticação básica (username:password)
AGT_USERNAME="ws.hml.addonsaftb1"
AGT_PASSWORD="***REDACTED***"

# =====================================
# DADOS DA EMPRESA
# =====================================
# NIF (Número de Identificação Fiscal)
COMPANY_TAX_ID="5417062030"

# Nome da Empresa
COMPANY_NAME="EMPRESA DE TESTE"

# Código de Actividade Económica
EAC_CODE="68200"  # Actividades imobiliárias por conta de outrem

# =====================================
# INFORMAÇÕES DO SOFTWARE
# =====================================
# Nome do Software
SOFTWARE_PRODUCT_ID="SafeFacturas"

# Versão do Software
SOFTWARE_VERSION="1.0.1"

# Número de Validação do Software (emitido pela AGT)
SOFTWARE_VALIDATION_NUMBER="FE/164/AGT/2026"

# =====================================
# CONFIGURAÇÕES GERAIS
# =====================================
# Espaço de nomes para UUID
UUID_NAMESPACE="5417062030"

# =====================================
# AMBIENTE (opcional)
# =====================================
NODE_ENV="development"
LOG_LEVEL="debug"
