###############################################################################
# TODOS EM LOTE (array de pedidos — submissão individual por documento)
###############################################################################
### Ficheiro consolidado (referência)
# < ./data/test-payloads/_ALL_PAYLOADS_CERTIFICACAO.json

###############################################################################
# PÓS-SUBMISSÃO
###############################################################################
### Obter estado de validação
GET {{baseUrl}}/obterEstado?requestID=YOUR_REQUEST_ID_HERE
Authorization: {{authToken}}

### Consultar documento registado
GET {{baseUrl}}/consultarFactura?documentNo=FT%202026A%2F000125&taxRegistrationNumber=5000660086
Authorization: {{authToken}}

### Listar séries autorizadas (verificar séries 2026A/2026B/2026C)
GET {{baseUrl}}/listarSeries?taxRegistrationNumber=5000660086
Authorization: {{authToken}}
