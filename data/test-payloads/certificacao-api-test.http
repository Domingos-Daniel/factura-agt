/**
 * CERTIFICAÇÃO AGT — 18 TIPOS DE DOCUMENTO — SCHEMA 2.0
 * =====================================================
 * Colecção para REST Client (VS Code) ou referência de implementação.
 *
 * Documentação: https://portaldoparceiro.hml.minfin.gov.ao/doc-agt/faturacao-electronica/1/servicos/registar.html
 *
 * Pré-requisitos:
 *   1. Substituir {{authToken}} pelo token válido de HML.
 *   2. Substituir as assinaturas mock (jws*) por JWS RS256 reais (Base64URL).
 *   3. Confirmar que as séries 2026A / 2026B / 2026C estão autorizadas.
 *   4. Confirmar o signatureVersion registado para o produtor de software.
 *
 * Os ficheiros referenciados estão em data/test-payloads/ e usam schemaVersion 2.0.
 */

@baseUrl = https://sifphml.minfin.gov.ao/sigt/fe/v1
@authToken = Bearer YOUR_TOKEN_HERE

# PRODUÇÃO (usar apenas após certificação)
# @baseUrl = https://sifp.minfin.gov.ao/sigt/fe/v1

###############################################################################
# 1. AC — Aviso de Cobrança
###############################################################################
### Registar Aviso de Cobrança
POST {{baseUrl}}/registarFactura
Content-Type: application/json
Authorization: {{authToken}}

< ./data/test-payloads/CERT_AC_Aviso_Cobranca.json

###############################################################################
# 2. AF — Factura/Recibo de Autofacturação (documentStatus = S)
###############################################################################
### Registar Autofacturação
POST {{baseUrl}}/registarFactura
Content-Type: application/json
Authorization: {{authToken}}

< ./data/test-payloads/CERT_AF_Autofacturacao.json

###############################################################################
# 3. AR — Aviso de Cobrança/Recibo (sem linhas, com paymentReceipt)
###############################################################################
### Registar Aviso de Cobrança/Recibo
POST {{baseUrl}}/registarFactura
Content-Type: application/json
Authorization: {{authToken}}

< ./data/test-payloads/CERT_AR_Aviso_Cobranca_Recibo.json

